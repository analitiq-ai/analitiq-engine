{
  "$schema": "https://schemas.analitiq.ai/type-map/latest.json",
  "read": [
    {
      "match": "exact",
      "native_type": "BOOLEAN",
      "arrow_type": "Boolean"
    },
    {
      "match": "exact",
      "native_type": "SMALLINT",
      "arrow_type": "Int16"
    },
    {
      "match": "exact",
      "native_type": "INTEGER",
      "arrow_type": "Int32"
    },
    {
      "match": "exact",
      "native_type": "BIGINT",
      "arrow_type": "Int64"
    },
    {
      "match": "exact",
      "native_type": "DOUBLE PRECISION",
      "arrow_type": "Float64"
    },
    {
      "match": "exact",
      "native_type": "TEXT",
      "arrow_type": "Utf8"
    },
    {
      "match": "regex",
      "native_type": "^NUMERIC\\((?<precision>[1-9]|[12][0-9]|3[0-8]), (?<scale>[0-9]|[12][0-9]|3[0-8])\\)$",
      "arrow_type": "Decimal128(${precision}, ${scale})"
    },
    {
      "match": "exact",
      "native_type": "DATE",
      "arrow_type": "Date32"
    },
    {
      "match": "exact",
      "native_type": "TIMESTAMPTZ",
      "arrow_type": "Timestamp(MICROSECOND, UTC)"
    },
    {
      "match": "regex",
      "native_type": "^TIMESTAMP(\\([4-6]\\))?( WITHOUT TIME ZONE)?$",
      "arrow_type": "Timestamp(MICROSECOND)"
    },
    {
      "match": "regex",
      "native_type": "^TIMESTAMP(\\([4-6]\\))? WITH TIME ZONE$",
      "arrow_type": "Timestamp(MICROSECOND, UTC)"
    },
    {
      "match": "exact",
      "native_type": "JSONB",
      "arrow_type": "Json"
    }
  ],
  "write": [
    {
      "match": "exact",
      "arrow_type": "Boolean",
      "native_type": "BOOLEAN"
    },
    {
      "match": "exact",
      "arrow_type": "Int16",
      "native_type": "SMALLINT"
    },
    {
      "match": "exact",
      "arrow_type": "Int32",
      "native_type": "INTEGER"
    },
    {
      "match": "exact",
      "arrow_type": "Int64",
      "native_type": "BIGINT"
    },
    {
      "match": "exact",
      "arrow_type": "Float64",
      "native_type": "DOUBLE PRECISION"
    },
    {
      "match": "exact",
      "arrow_type": "Utf8",
      "native_type": "TEXT"
    },
    {
      "match": "regex",
      "arrow_type": "^Decimal128\\((?<p>\\d+), (?<s>\\d+)\\)$",
      "native_type": "NUMERIC(${p}, ${s})"
    },
    {
      "match": "exact",
      "arrow_type": "Date32",
      "native_type": "DATE"
    },
    {
      "match": "exact",
      "arrow_type": "Timestamp(MICROSECOND, UTC)",
      "native_type": "TIMESTAMPTZ"
    },
    {
      "match": "exact",
      "arrow_type": "Timestamp(MICROSECOND)",
      "native_type": "TIMESTAMP"
    },
    {
      "match": "exact",
      "arrow_type": "Json",
      "native_type": "JSONB"
    }
  ]
}
