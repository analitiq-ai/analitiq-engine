{
  "case_id": "read-keyset",
  "why": "Keyset paging: the ordering field the loop reads off the last record, and its initial bound.",
  "batch_size": 2,
  "pages": [
    {
      "entries": [
        {
          "id": 1,
          "sequence": 1,
          "name": "n1"
        },
        {
          "id": 2,
          "sequence": 2,
          "name": "n2"
        }
      ]
    },
    {
      "entries": []
    }
  ],
  "document": {
    "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
    "endpoint_id": "keyset-entries",
    "operations": {
      "read": {
        "request": {
          "method": "GET",
          "path": "/v1/keyset-entries",
          "query": {
            "count": {
              "from_param": "count"
            },
            "after_sequence": {
              "from_param": "after_sequence"
            }
          }
        },
        "params": {
          "count": {
            "in": "query",
            "type": "integer",
            "required": false,
            "controlled_by": "pagination"
          },
          "after_sequence": {
            "in": "query",
            "type": "integer",
            "required": false,
            "controlled_by": "pagination"
          }
        },
        "pagination": {
          "type": "keyset",
          "limit": {
            "param": "count",
            "default": {
              "ref": "runtime.batch_size"
            },
            "max": 1000
          },
          "keyset": {
            "param": "after_sequence",
            "order_by_field": "sequence",
            "initial": 0
          },
          "stop_when": {
            "or": [
              {
                "empty": {
                  "ref": "response.body.entries"
                }
              },
              {
                "gt": [
                  {
                    "ref": "response.record_count"
                  },
                  1000
                ]
              }
            ]
          }
        },
        "response": {
          "records": {
            "ref": "response.body.entries"
          },
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "native_type": "integer",
                      "arrow_type": "Int64"
                    },
                    "sequence": {
                      "type": "integer",
                      "native_type": "integer",
                      "arrow_type": "Int64"
                    },
                    "name": {
                      "type": "string",
                      "native_type": "string",
                      "arrow_type": "Utf8"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
