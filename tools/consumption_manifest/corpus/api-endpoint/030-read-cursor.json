{
  "case_id": "read-cursor",
  "why": "Opaque-cursor paging, with a derived function at each of the two typed expression slots the loop resolves on every page.",
  "batch_size": 2,
  "pages": [
    {
      "results": [
        {
          "id": 1,
          "sequence": 1,
          "name": "n1"
        },
        {
          "id": 2,
          "sequence": 2,
          "name": "n2"
        }
      ],
      "meta": {
        "next_token": "t2",
        "returned": 2
      }
    },
    {
      "results": [
        {
          "id": 3,
          "sequence": 3,
          "name": "n3"
        }
      ],
      "meta": {
        "next_token": null,
        "returned": 1
      }
    }
  ],
  "document": {
    "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
    "endpoint_id": "cursor-items",
    "operations": {
      "read": {
        "request": {
          "method": "GET",
          "path": "/v1/cursor-items",
          "query": {
            "pageSize": {
              "from_param": "page_size"
            },
            "pageToken": {
              "from_param": "page_token"
            }
          }
        },
        "params": {
          "page_size": {
            "in": "query",
            "type": "integer",
            "required": false,
            "controlled_by": "pagination"
          },
          "page_token": {
            "in": "query",
            "type": "string",
            "required": false,
            "controlled_by": "pagination"
          }
        },
        "pagination": {
          "type": "cursor",
          "limit": {
            "param": "page_size",
            "default": {
              "function": "lookup",
              "input": {
                "ref": "runtime.batch_size"
              },
              "map": {
                "2": 2
              }
            },
            "max": 250
          },
          "cursor": {
            "param": "page_token",
            "next_cursor": {
              "function": "url_encode",
              "input": {
                "ref": "response.body.meta.next_token"
              },
              "safe": "-"
            }
          },
          "stop_when": {
            "lt": [
              {
                "ref": "response.body.meta.returned"
              },
              {
                "ref": "runtime.batch_size"
              }
            ]
          }
        },
        "response": {
          "records": {
            "ref": "response.body.results"
          },
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "native_type": "integer",
                      "arrow_type": "Int64"
                    },
                    "sequence": {
                      "type": "integer",
                      "native_type": "integer",
                      "arrow_type": "Int64"
                    },
                    "name": {
                      "type": "string",
                      "native_type": "string",
                      "arrow_type": "Utf8"
                    }
                  }
                }
              },
              "meta": {
                "type": "object",
                "properties": {
                  "next_token": {
                    "type": "string"
                  },
                  "returned": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
